+def _clear_admin_input_modes(user_data):
+    for key in ("admin_oem_search","admin_topup","admin_debit","admin_credit","admin_due"):
+        user_data.pop(key,None)
+
+
+def _admin_search_keyboard():
+    return InlineKeyboardMarkup([
+        [InlineKeyboardButton("🔎 Искать ещё",callback_data="admsearch")],
+        [InlineKeyboardButton("← В ADMIN",callback_data="admhome")],
+    ])
+
+def _admin_offer_text(oem, offer):
+    """Dealer semantics HOLD: never display legacy numeric field as Dealer Price."""
+    status=str(offer.get("status") or "DEALER_PRICE_UNVERIFIED")
+    reason=str(offer.get("price_error") or offer.get("error_code") or status)
+    return "\n".join(["🔎 Поиск по OEM","",f"OEM: {oem}",
+       "Дилерская цена недоступна.",
+       f"Статус: {status}",f"Причина: {reason}",
+       "MSRP не используется вместо Dealer Price."])
+
+async def _resolve_admin_oem_offer(oem,context):
+    """Read-only catalog identity only; positive Dealer semantics remain on HOLD."""
+    try:
+        # Existing catalog path can be inspected for identity, not price promotion.
+        result=await asyncio.to_thread(resolve_offer,oem)
+        status=str(result.get("status") or "DEALER_PRICE_UNVERIFIED")
+    except Exception:
+        status="TECHNICAL_ERROR"
+    # Independent dealer semantic source not approved; never promote legacy price.
+    return {"status":"DEALER_PRICE_UNVERIFIED",
+            "price_error":"positive_dealer_source_not_proven",
+            "catalog_status":status}
+
